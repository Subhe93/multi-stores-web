# Storefront environment. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are inlined into the browser bundle; everything else
# stays on the server.

# Every NEXT_PUBLIC_* value below is inlined at BUILD time: changing one
# needs `npm run build` + restart, not just a restart.

# API base URL (with /api). Production: https://api.shopsdoor.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Public URL of this storefront: the PRIMARY platform host. Every generated
# link (canonical / hreflang / sitemap origins `<slug>.<host>`, market
# preview hosts `<slug>--<key>.<host>`) follows it. Production: https://shopsdoor.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Public URL of the dashboard (sign-in redirects, builder preview parent
# origin). Production: https://app.shopsdoor.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002
# Extra dashboard origins (comma separated) the builder preview iframe may
# be embedded from, besides NEXT_PUBLIC_DASHBOARD_URL — the old dashboard
# host during a domain move. Empty = only NEXT_PUBLIC_DASHBOARD_URL.
# NEXT_PUBLIC_DASHBOARD_ORIGINS=https://ms-dash.iwings-digital.com
NEXT_PUBLIC_DASHBOARD_ORIGINS=
# Store routing (src/proxy.ts). The platform hosts = the host of
# NEXT_PUBLIC_WEB_URL (bare + www) plus NEXT_PUBLIC_PLATFORM_HOSTS (comma
# separated); a request on an exact platform host is the marketing site,
# `<slug>.<any platform host>` is that store, anything else a custom domain.
# During the domain move list both apexes so old and new store subdomains
# both resolve:
# NEXT_PUBLIC_PLATFORM_HOSTS=shopsdoor.com,www.shopsdoor.com,iwings-digital.com,www.iwings-digital.com
NEXT_PUBLIC_PLATFORM_HOSTS=
# Domain the canonical `/store/<slug>` redirect sends visitors to. Default:
# the first non-localhost platform host (i.e. the NEXT_PUBLIC_WEB_URL host),
# so it only needs setting when that is not wanted. Production: shopsdoor.com
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key for the platform sign-up (/auth/register).
# Empty = no captcha widget; set it together with the API's
# TURNSTILE_SECRET_KEY (the API then requires the token).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared secret for POST /api/revalidate (header x-revalidate-secret).
REVALIDATE_SECRET=

# Server-only shared key of the redirect proxy (M4.4). When set, the proxy
# sends it as the `x-proxy-key` header on the store redirect map and resolve
# calls, and the API lifts its per-IP throttle for them. Use the same value as
# REDIRECTS_PROXY_KEY on the API (at least 16 characters, e.g.
# `openssl rand -hex 32`). Never prefix it with NEXT_PUBLIC_.
REDIRECTS_PROXY_KEY=
