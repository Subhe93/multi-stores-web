# Storefront environment. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are inlined into the browser bundle; everything else
# stays on the server.

# API base URL (with /api).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Public URL of this storefront and of the dashboard.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002
# Platform domain and extra platform hosts (comma-separated) for store routing.
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_PLATFORM_HOSTS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shared secret for POST /api/revalidate (header x-revalidate-secret).
REVALIDATE_SECRET=

# Server-only shared key of the redirect proxy (M4.4). When set, the proxy
# sends it as the `x-proxy-key` header on the store redirect map and resolve
# calls, and the API lifts its per-IP throttle for them. Use the same value as
# REDIRECTS_PROXY_KEY on the API (at least 16 characters, e.g.
# `openssl rand -hex 32`). Never prefix it with NEXT_PUBLIC_.
REDIRECTS_PROXY_KEY=
