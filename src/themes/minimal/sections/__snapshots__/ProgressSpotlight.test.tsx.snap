// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`progress-spotlight split with an image (unchanged) > image at the end, in the builder preview too 1`] = `"<section style="width:100vw;max-width:100vw;margin-inline:calc(50% - 50vw);background-color:var(--theme-colors-primary);color:var(--theme-colors-primaryContrast, #fff)" data-bleed-split="bleed"><div class="grid md:grid-cols-2"><div class="relative overflow-hidden aspect-[4/3] md:aspect-auto md:min-h-[480px] md:order-2"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:center;color:transparent" sizes="(min-width: 768px) 50vw, 100vw" srcSet="/_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=3840&amp;q=75"/></div><div class="flex items-center md:order-1 [--g:1rem] sm:[--g:1.5rem] lg:[--g:2rem] [--bs-in:var(--g)] md:[--bs-in:clamp(1.5rem,4vw,4rem)]" style="padding-inline-start:max(var(--g), calc((100vw - var(--theme-container-max, 1200px)) / 2 + var(--g)));padding-inline-end:var(--bs-in)"><div class="w-full max-w-xl py-10 md:py-16 [overflow-wrap:anywhere]"><div class="flex flex-col gap-3"><span data-text-look="body" style="color:var(--theme-colors-primaryContrast, #fff)" class="text-xs font-semibold uppercase tracking-[0.2em] rtl:tracking-normal">Our goal</span><h2 data-text-look="heading" style="font-family:var(--theme-font-heading);font-size:var(--theme-scale-h2);font-weight:var(--theme-weight-heading);line-height:var(--theme-line-heading);letter-spacing:var(--theme-tracking-heading);color:var(--theme-colors-primaryContrast, #fff)">Follow our progress</h2><p class="max-w-prose" style="color:color-mix(in srgb, var(--theme-colors-primaryContrast, #fff) 80%, transparent);line-height:var(--theme-line-body)">Describe what you are working towards and why it matters. The bar is calculated from the two numbers you enter.</p></div><div class="mt-6 p-4 md:p-5" style="background:var(--theme-colors-background);color:var(--theme-colors-text);border:1px solid var(--theme-colors-border);border-radius:var(--theme-radius-md)" data-progress-panel=""><div class="flex items-start gap-3"><div class="min-w-0 flex-1"><p class="font-semibold leading-tight">Name of the goal</p><p class="text-sm" style="color:var(--theme-colors-muted)">Where or when</p></div><span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full" style="background-color:var(--theme-colors-background);border:1px solid var(--theme-colors-border);color:var(--theme-colors-text)" data-status="planned"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dashed size-3.5" aria-hidden="true"><path d="M10.1 2.182a10 10 0 0 1 3.8 0"></path><path d="M13.9 21.818a10 10 0 0 1-3.8 0"></path><path d="M17.609 3.721a10 10 0 0 1 2.69 2.7"></path><path d="M2.182 13.9a10 10 0 0 1 0-3.8"></path><path d="M20.279 17.609a10 10 0 0 1-2.7 2.69"></path><path d="M21.818 10.1a10 10 0 0 1 0 3.8"></path><path d="M3.721 6.391a10 10 0 0 1 2.7-2.69"></path><path d="M6.391 20.279a10 10 0 0 1-2.69-2.7"></path></svg>sections.status.planned</span></div><p class="mt-2 text-sm">sections.progress.goal[goal=100] completed</p></div><div class="mt-6"><a href="/learn-more" class="inline-flex items-center gap-2 px-6 py-3 motion-safe:transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" style="background-color:var(--theme-colors-primaryContrast, #fff);color:var(--theme-colors-primary);border-radius:var(--theme-radius-button, var(--theme-radius-full));border:0 solid transparent;font-weight:var(--theme-weight-bold);outline-color:var(--theme-colors-primaryContrast, #fff)">Learn more</a></div></div></div></div></section>"`;

exports[`progress-spotlight split with an image (unchanged) > image at the start 1`] = `"<section style="width:100vw;max-width:100vw;margin-inline:calc(50% - 50vw);background-color:var(--theme-colors-surface);color:var(--theme-colors-text)" data-bleed-split="bleed"><div class="grid md:grid-cols-2"><div class="relative overflow-hidden aspect-[4/3] md:aspect-auto md:min-h-[480px]"><img alt="A classroom" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:center;color:transparent" sizes="(min-width: 768px) 50vw, 100vw" srcSet="/_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=http%3A%2F%2Flocalhost%3A3001%2Fuploads%2Fpages%2Fgoal.jpg&amp;w=3840&amp;q=75"/></div><div class="flex items-center [--g:1rem] sm:[--g:1.5rem] lg:[--g:2rem] [--bs-in:var(--g)] md:[--bs-in:clamp(1.5rem,4vw,4rem)]" style="padding-inline-start:var(--bs-in);padding-inline-end:max(var(--g), calc((100vw - var(--theme-container-max, 1200px)) / 2 + var(--g)))"><div class="w-full max-w-xl py-10 md:py-16 [overflow-wrap:anywhere]"><div class="flex flex-col gap-3"><span data-text-look="body" style="color:var(--theme-colors-accent)" class="text-xs font-semibold uppercase tracking-[0.2em] rtl:tracking-normal">Our goal</span><h2 data-text-look="heading" style="font-family:var(--theme-font-heading);font-size:var(--theme-scale-h2);font-weight:var(--theme-weight-heading);line-height:var(--theme-line-heading);letter-spacing:var(--theme-tracking-heading);color:var(--theme-colors-text)">Follow our progress</h2><p class="max-w-prose" style="color:var(--theme-colors-muted);line-height:var(--theme-line-body)">Describe what you are working towards and why it matters. The bar is calculated from the two numbers you enter.</p></div><div class="mt-6 p-4 md:p-5" style="background:var(--theme-colors-background);color:var(--theme-colors-text);border:1px solid var(--theme-colors-border);border-radius:var(--theme-radius-md)" data-progress-panel=""><div class="flex items-start gap-3"><div class="min-w-0 flex-1"><p class="font-semibold leading-tight">Name of the goal</p><p class="text-sm" style="color:var(--theme-colors-muted)">Where or when</p></div><span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-full" style="background-color:var(--theme-colors-accent);color:var(--theme-colors-accentContrast, #fff)" data-status="in_progress"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dot size-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="1"></circle></svg>sections.status.inProgress</span></div><div class="mt-3 flex items-center gap-3" data-progress-bar=""><div role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="60" aria-valuetext="sections.progress.reachedOfGoal[reached=60,goal=100] completed" aria-label="Name of the goal" class="h-2 w-full rounded-full overflow-hidden" style="background-color:color-mix(in srgb, currentColor 15%, transparent)"><div class="h-full rounded-full" style="width:60%;background:var(--theme-colors-accent)"></div></div><span class="text-sm font-semibold tabular-nums">60%</span></div><p class="mt-2 text-sm">sections.progress.reachedOfGoal[reached=60,goal=100] completed</p></div><div class="mt-6"><a href="/learn-more" class="inline-flex items-center gap-2 px-6 py-3 motion-safe:transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2" style="background-color:var(--theme-colors-primary);color:var(--theme-colors-primaryContrast, #fff);border-radius:var(--theme-radius-button, var(--theme-radius-full));border:0 solid transparent;font-weight:var(--theme-weight-bold);outline-color:var(--theme-colors-text)">Learn more</a></div></div></div></div></section>"`;
